<%- include('partials/header') %>

<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Dashboard</h1>
        <p class="hero-desc">Welcome back, <strong><%= name %></strong>! Here's your account overview.</p>

        <div class="hero-actions">
            <a href="/organizations" class="btn btn-primary">View Organizations</a>
            <a href="/projects" class="btn btn-outline">Explore Projects</a>
        </div>
    </div>
</section>

<section class="features">
    <div class="container">
        <div class="feature-grid">

            <div class="feature-card">
                <h3>Your Profile</h3>
                <p><strong>Name:</strong> <%= name %></p>
                <p><strong>Email:</strong> <%= email %></p>
                <p><strong>Role:</strong> <%= user.role_name %></p>
            </div>

            <% if (user && user.role_name === 'admin') { %>
                <div class="feature-card">
                    <h3>Admin Tools</h3>
                    <p>Manage registered users and system settings.</p>
                    <a href="/users" class="btn btn-primary" style="margin-top: 1rem;">View All Users</a>
                </div>
            <% } %>

        </div>

        <%# Volunteer projects section %>
        <div class="volunteer-projects" style="margin-top: 2rem;">
            <h2>Your Volunteer Projects</h2>

            <% if (volunteerProjects && volunteerProjects.length > 0) { %>
                <ul class="volunteer-list">
                    <% volunteerProjects.forEach(project => { %>
                        <li class="volunteer-item">
                            <div>
                                <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
                                <p><%= project.organization_name %> &bull;
                                    <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>
                                </p>
                                <p><%= project.location %></p>
                            </div>
                            <form action="/project/<%= project.project_id %>/unvolunteer?from=dashboard" method="POST">
                                <button type="submit" class="btn-danger">Remove</button>
                            </form>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <p>You have not signed up for any projects yet. <a href="/projects">Browse projects</a> to find one.</p>
            <% } %>
        </div>

    </div>
</section>

<%- include('partials/footer') %>