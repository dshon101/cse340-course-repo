<%- include('partials/header') %>

<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Dashboard</h1>
        <p class="hero-desc">Welcome back, <strong><%= name %></strong>! Here's your account overview.</p>

        <div class="hero-actions">
            <a href="/organizations" class="btn btn-primary">View Organizations</a>
            <a href="/projects" class="btn btn-outline">Explore Projects</a>
        </div>
    </div>
</section>

<section class="features">
    <div class="container">
        <div class="feature-grid">

            <div class="feature-card">
                <h3>Your Profile</h3>
                <p><strong>Name:</strong> <%= name %></p>
                <p><strong>Email:</strong> <%= email %></p>
                <p><strong>Role:</strong> <%= user.role_name %></p>
            </div>

            <% if (user && user.role_name === 'admin') { %>
                <div class="feature-card">
                    <h3>Admin Tools</h3>
                    <p>Manage registered users and system settings.</p>
                    <a href="/users" class="btn btn-primary" style="margin-top: 1rem;">View All Users</a>
                </div>
            <% } %>

        </div>

        <%# My Volunteer Projects section %>
        <div class="volunteer-projects" style="margin-top: 3rem;">
            <h2>My Volunteer Projects</h2>

            <% if (volunteerProjects && volunteerProjects.length > 0) { %>
                <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
                    <thead>
                        <tr style="background-color: #f4f4f4; text-align: left;">
                            <th style="padding: 0.75rem; border: 1px solid #ddd;">Project</th>
                            <th style="padding: 0.75rem; border: 1px solid #ddd;">Organization</th>
                            <th style="padding: 0.75rem; border: 1px solid #ddd;">Date</th>
                            <th style="padding: 0.75rem; border: 1px solid #ddd;">Location</th>
                            <th style="padding: 0.75rem; border: 1px solid #ddd;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% volunteerProjects.forEach(project => { %>
                            <tr>
                                <td style="padding: 0.75rem; border: 1px solid #ddd;">
                                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                                </td>
                                <td style="padding: 0.75rem; border: 1px solid #ddd;"><%= project.organization_name %></td>
                                <td style="padding: 0.75rem; border: 1px solid #ddd;">
                                    <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>
                                </td>
                                <td style="padding: 0.75rem; border: 1px solid #ddd;"><%= project.location %></td>
                                <td style="padding: 0.75rem; border: 1px solid #ddd;">
                                    <form action="/project/<%= project.project_id %>/unvolunteer?from=dashboard" method="POST">
                                        <button type="submit" class="btn-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p style="margin-top: 1rem;">You have not signed up for any projects yet. <a href="/projects">Browse projects</a> to find one you'd like to volunteer for.</p>
            <% } %>
        </div>

    </div>
</section>

<%- include('partials/footer') %>