<%- include('partials/header') %>

<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Dashboard</h1>
        <p class="hero-desc">Welcome back, <strong><%= name %></strong>! Here's your account overview.</p>

        <div class="hero-actions">
            <a href="/organizations" class="btn btn-primary">View Organizations</a>
            <a href="/projects" class="btn btn-outline">Explore Projects</a>
        </div>
    </div>
</section>

<section class="features">
    <div class="container">
        <div class="feature-grid">
            <div class="feature-card">
                <h3>Your Profile</h3>
                <p><strong>Name:</strong> <%= name %></p>
                <p><strong>Email:</strong> <%= email %></p>
                <p><strong>Role:</strong> <%= user.role_name %></p>
            </div>

            <% if (user && user.role_name === 'admin') { %>
                <div class="feature-card">
                    <h3>Admin Tools</h3>
                    <p>Manage registered users and system settings.</p>
                    <a href="/users" class="btn btn-primary" style="margin-top: 1rem;">View All Users</a>
                </div>
            <% } %>
        </div>
    </div>
</section>

<%- include('partials/footer') %>