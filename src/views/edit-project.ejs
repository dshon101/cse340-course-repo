<%- include('partials/header') %>

<section class="page-hero">
    <div class="container">
        <h1 class="page-title"><%= title %></h1>
    </div>
</section>

<section class="container">
    <div class="form-section">
        <form action="/edit-project/<%= project.project_id %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= project.title %>" maxlength="200" required />
            </div>
            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="1000" required><%= project.description %></textarea>
            </div>
            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= project.location %>" maxlength="200" required />
            </div>
            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" value="<%= new Date(project.project_date).toISOString().split('T')[0] %>" required />
            </div>
            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="">Select an organization</option>
                    <% organizations.forEach(org => { %>
                        <option value="<%= org.organization_id %>"
                            <%= org.organization_id === project.organization_id ? 'selected' : '' %>
                        ><%= org.name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="action-buttons">
                <button type="submit" class="btn-primary">Update Project</button>
                <a href="/project/<%= project.project_id %>" class="btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</section>

<%- include('partials/footer') %>