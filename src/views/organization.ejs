<%- include('./partials/header') %>

    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">
                <%= organization.name %>
            </h1>
        </div>
    </section>

    <section class="container">
        <p>
            <%= organization.description %>
        </p>
        <p><strong>Contact:</strong>
            <%= organization.contact_email %>
        </p>
    </section>

    <section class="container">
        <h2>Service Projects</h2>
        <% if (projects && projects.length > 0) { %>
            <ul class="project-list">
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                        — <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No service projects found for this organization.</p>
        <% } %>
    </section>

<%- include('./partials/footer') %>
