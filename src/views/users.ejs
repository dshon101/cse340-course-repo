<%- include('./partials/header') %>

<section class="page-hero">
    <div class="container">
        <h1 class="page-title">Registered Users</h1>
        <p>All registered users and their roles.</p>
    </div>
</section>

<section class="container" style="margin-top: 2rem; margin-bottom: 3rem;">
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="background-color: #2d5a27; color: white; text-align: left;">
                <th style="padding: 0.75rem; border: 1px solid #ddd;">Name</th>
                <th style="padding: 0.75rem; border: 1px solid #ddd;">Email</th>
                <th style="padding: 0.75rem; border: 1px solid #ddd;">Role</th>
                <th style="padding: 0.75rem; border: 1px solid #ddd;">Joined</th>
                <th style="padding: 0.75rem; border: 1px solid #ddd;">Volunteered Projects</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(u => { %>
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 0.75rem; border: 1px solid #ddd;"><%= u.name %></td>
                    <td style="padding: 0.75rem; border: 1px solid #ddd;"><%= u.email %></td>
                    <td style="padding: 0.75rem; border: 1px solid #ddd;">
                        <% if (u.role_name === 'admin') { %>
                            <span style="padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; background-color: #f5a623; color: #fff;">
                                Admin
                            </span>
                        <% } else { %>
                            <span style="padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; background-color: #e0f0e0; color: #2d5a27;">
                                User
                            </span>
                        <% } %>
                    </td>
                    <td style="padding: 0.75rem; border: 1px solid #ddd;">
                        <%= new Date(u.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                    </td>
                    <td style="padding: 0.75rem; border: 1px solid #ddd;">
                        <% const projects = volunteersByUser[u.user_id]; %>
                        <% if (projects && projects.length > 0) { %>
                            <ul style="margin: 0; padding-left: 1.2rem;">
                                <% projects.forEach(p => { %>
                                    <li style="margin-bottom: 0.3rem;">
                                        <a href="/project/<%= p.project_id %>"><%= p.project_title %></a>
                                        <span style="color: #888; font-size: 0.85rem;">
                                            — <%= p.organization_name %>,
                                            <%= new Date(p.project_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) %>
                                        </span>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } else { %>
                            <span style="color: #aaa; font-size: 0.9rem;">No signups yet</span>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</section>

<%- include('./partials/footer') %>