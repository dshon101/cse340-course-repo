<%- include('partials/header') %>

<section class="page-hero">
    <div class="container">
        <h1 class="page-title"><%= title %></h1>
        <p class="page-subtitle">All registered users and their roles.</p>
    </div>
</section>

<section class="container" style="padding: 2rem 0;">
    <table class="users-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Joined</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><span class="role-badge role-<%= user.role_name %>"><%= user.role_name %></span></td>
                    <td><%= new Date(user.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</section>

<%- include('partials/footer') %>