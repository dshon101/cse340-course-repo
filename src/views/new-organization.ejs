<%- include('partials/header') %>

<section class="page-hero">
    <div class="container">
        <h1 class="page-title"><%= title %></h1>
    </div>
</section>

<section class="container">
    <div class="form-section">
        <form action="/new-organization" method="POST">
            <div class="form-group">
                <label for="name">Organization Name</label>
                <input type="text" id="name" name="name" maxlength="150" required placeholder="e.g. Green Harvest Collective" />
            </div>
            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="500" required placeholder="Describe what this organization does..."></textarea>
            </div>
            <div class="form-group">
                <label for="contactEmail">Contact Email</label>
                <input type="email" id="contactEmail" name="contactEmail" required placeholder="contact@example.org" />
            </div>
            <button type="submit" class="btn-primary">Create Organization</button>
        </form>
    </div>
</section>

<%- include('partials/footer') %>