<%- include('./partials/header') %>

    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">
                <%= project.title %>
            </h1>
        </div>
    </section>

    <section class="container">
        <p><%= project.description %></p>
        <p><strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>
        </p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>

        <% if (categories && categories.length > 0) { %>
            <div class="category-tags">
                <strong>Categories:</strong>
                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>" class="category-tag"><%= category.name %></a>
                <% }); %>
            </div>
        <% } %>
    </section>
    <section class="container">
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
    </section>

<%- include('./partials/footer') %>
