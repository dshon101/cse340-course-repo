<%- include('./partials/header') %>

<section class="page-hero">
    <div class="container">
        <h1 class="page-title"><%= project.title %></h1>
    </div>
</section>

<section class="container">
    <div class="detail-card">
        <p><%= project.description %></p>
        <p><strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>
        </p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>

        <% if (categories && categories.length > 0) { %>
            <p><strong>Categories:</strong></p>
            <div class="category-tags">
                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>" class="category-tag"><%= category.name %></a>
                <% }); %>
            </div>
        <% } %>
    </div>

    <%# Volunteer section — only show if the user is logged in %>
    <% if (isLoggedIn) { %>
        <div class="volunteer-section">
            <% if (userIsVolunteer) { %>
                <p class="volunteer-status">✅ You are volunteering for this project.</p>
                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                    <button type="submit" class="btn-danger">Remove me as a volunteer</button>
                </form>
            <% } else { %>
                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit" class="btn-primary">🙋 Volunteer for this project</button>
                </form>
            <% } %>
        </div>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <div class="action-buttons">
            <a href="/edit-project/<%= project.project_id %>" class="btn-secondary">✏️ Edit Project</a>
            <a href="/assign-categories/<%= project.project_id %>" class="btn-secondary">🏷️ Edit Categories</a>
        </div>
    <% } %>
</section>

<%- include('./partials/footer') %>