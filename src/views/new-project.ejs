<%- include('partials/header') %>

<section class="page-hero">
    <div class="container">
        <h1 class="page-title"><%= title %></h1>
    </div>
</section>

<section class="container">
    <div class="form-section">
        <form action="/new-project" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" maxlength="200" required placeholder="e.g. Park & Trail Cleanup" />
            </div>
            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="1000" required placeholder="Describe what volunteers will be doing..."></textarea>
            </div>
            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" maxlength="200" required placeholder="e.g. Riverside Park" />
            </div>
            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" required />
            </div>
            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="">Select an organization</option>
                    <% organizations.forEach(org => { %>
                        <option value="<%= org.organization_id %>"><%= org.name %></option>
                    <% }); %>
                </select>
            </div>
            <button type="submit" class="btn-primary">Create Project</button>
        </form>
    </div>
</section>

<%- include('partials/footer') %>